{
  "uid": "pipeline-health",
  "title": "Pipeline Health",
  "tags": ["pipeline", "monitoring", "data-quality"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Latest Pipeline Status",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "eco-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT source, dag_id, run_date, status, started_at, finished_at, ROUND(EXTRACT(EPOCH FROM (COALESCE(finished_at, NOW()) - started_at))::numeric, 2) AS duration_seconds, records_count, error_message FROM serving.v_pipeline_status ORDER BY source;"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Latest Status Counts",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "eco-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) FILTER (WHERE status = 'success') AS successful, COUNT(*) FILTER (WHERE status = 'failed') AS failed, COUNT(*) FILTER (WHERE status = 'running') AS running FROM serving.v_pipeline_status;"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Rejected Records by Cause",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "eco-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT source || ' / ' || stage || ' / ' || reason AS cause, rejected_count FROM serving.v_rejected_summary ORDER BY rejected_count DESC;"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "cause",
        "showValue": "always",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "barRadius": 0,
        "stacking": "none",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 4,
      "title": "Latest Data Quality Results",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "eco-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT source, check_name, severity, phase, passed, metric_value, details, checked_at FROM serving.v_quality_summary ORDER BY source, check_name;"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "title": "Failed Quality Checks",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "eco-postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS failed_checks FROM serving.v_quality_summary WHERE passed = false;"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      }
    }
  ]
}
